// Deployment of uptime.athas.mx. "/" and "/_estado/*" are routed to the separate "estado" Worker.
{
  "name": "openuptime-web",
  "compatibility_date": "2026-09-01",
  "vars": { "PRODUCT_URL": "https://uptime.athas.mx" },
  "routes": [{ "pattern": "uptime.athas.mx", "custom_domain": true }],
  "services": [{ "binding": "API", "service": "openuptime-api" }],
  "kv_namespaces": [{ "binding": "SESSION", "id": "d54759cbcbc342c2a2d701d7891278fd" }]
}
